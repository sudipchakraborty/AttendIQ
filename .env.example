# The backend checkout defaults to ../AttendIQ_BackEnd.
ATTENDIQ_BACKEND_DIR=../AttendIQ_BackEnd
# Leave unset for the same-origin /api gateway in production.
# VITE_API_BASE_URL=/api
# Build-time secret must match Contabo ATTENDIQ_GATEWAY_SECRET.
# Configure privately or through the encrypted GitHub Actions secret.
ATTENDIQ_GATEWAY_SECRET=
